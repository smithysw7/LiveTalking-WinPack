# ─────────────────────────────────────────────────────────────
# LiveTalking 配置（改完后重命名为 .env 即可生效）
# ─────────────────────────────────────────────────────────────

# ── 本地大模型（默认，无需任何 Key）──
# llama-server 监听地址（启动脚本会自动拉起，一般不用改）
# LLM_BASE_URL=http://127.0.0.1:8765/v1
# 数字人人设提示词（不填使用内置默认）
# LLM_SYSTEM_PROMPT=你是一位亲切的数字人助理，回答请简短口语化

# ── 云端大模型（可选，需在 config.yaml 中切换 llm_provider）──
# DASHSCOPE_API_KEY=sk-xxxxxxxx        # 阿里云百炼 qwen-plus
# DEEPSEEK_API_KEY=sk-xxxxxxxx         # DeepSeek deepseek-chat
# ZHIPU_API_KEY=xxxxxxxx.xxxxxxxx      # 智谱 GLM
# ORCAROUTER_API_KEY=xxxxxxxx

# ── 自定义 OpenAI 兼容端点（llm_provider=custom 时启用）──
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY=sk-xxxxxxxx
# LLM_MODEL=your-model-name

# ── 云端 TTS（可选，默认使用本地 Qwen3-TTS，无需配置）──
# TENCENT_APPID=xxxxxxxx
# TENCENT_SECRET_KEY=xxxxxxxx
# TENCENT_SECRET_ID=xxxxxxxx
# DOUBAO_API_KEY=xxxxxxxx
# AZURE_SPEECH_KEY=xxxxxxxx
# AZURE_TTS_ENDPOINT=xxxxxxxx
